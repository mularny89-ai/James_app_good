// Mellan Practice Manager — relational schema
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ---------- Configuration / Settings ----------

model CompanySettings {
  id               Int     @id @default(1)
  companyName      String  @default("Mellan Consulting Engineers")
  tradingName      String  @default("")
  abn              String  @default("")
  address          String  @default("")
  phone            String  @default("")
  email            String  @default("")
  website          String  @default("mellanconsulting.com.au")
  logoPath         String  @default("/uploads/branding/default-logo.webp")
  primaryColor     String  @default("#34368B")
  secondaryColor   String  @default("#23255F")
  gstRate          Float   @default(10)
  currency         String  @default("AUD")
  // Numbering — prefix + fixed-width digits, counters kept in NumberSequence
  jobPrefix        String  @default("J66")
  jobDigits        Int     @default(3)
  quotePrefix      String  @default("Q66")
  quoteDigits      Int     @default(3)
  invoicePrefix    String  @default("INV-")
  invoiceDigits    Int     @default(4)
  invoiceFormat    String  @default("YY####")
  // Statutory form defaults — JSON of engineer/business signatory details (Settings → Form Defaults)
  formDefaults     String  @default("{}")
  // Bank/payment details printed on invoices when "Payment Advice" is on
  paymentAdvice    String  @default("")
  // Quote email template — subject + body with {{mergeFields}} (Settings → Email Template)
  quoteEmailSubject String @default("")
  quoteEmailBody    String @default("")
  // Microsoft 365 (Outlook) connection — MSAL refresh-token cache, email address + tenant used to connect
  msalTokenCache  String @default("")
  msalAccount     String @default("")
  // Single-tenant app registration -> login must hit this tenant, not /common
  msalTenantId    String @default("3a228346-9ee3-4dbb-a8da-3a06fc8d550d")
  // Azure app client secret — set via the Email page; env MSAL_CLIENT_SECRET takes precedence
  msalClientSecret String @default("")
  // Anthropic API key for the email AI assistant — set via the Email page; env ANTHROPIC_API_KEY takes precedence
  aiApiKey String @default("")
  // Preferences
  dateFormat       String  @default("d MMM yyyy") // Australian
  timeFormat       String  @default("24h")
  updatedAt        DateTime @updatedAt
}

model NumberSequence {
  id        Int @id @default(autoincrement())
  key       String // "job" | "quote" | "invoice"
  year      Int
  nextValue Int @default(1)
  @@unique([key, year])
}

model Employee {
  id           Int     @id @default(autoincrement())
  firstName    String
  lastName     String  @default("")
  displayName  String
  position     String  @default("")
  email        String  @default("")
  phone        String  @default("")
  notes        String  @default("")
  active       Boolean @default(true)
  assignable   Boolean @default(true) // can be assigned to jobs
  order        Int     @default(0)
  createdAt    DateTime @default(now())
  jobs         Job[]
}

model JobStatus {
  id            Int    @id @default(autoincrement())
  name          String @unique
  order         Int    @default(0)
  color         String @default("#64748b")
  isBoardColumn Boolean @default(false) // shown as a Kanban column
  boardOrder    Int    @default(0)
  jobs          Job[]
}

model JobType {
  id    Int    @id @default(autoincrement())
  name  String @unique
  order Int    @default(0)
  jobs  Job[]
}

model TaskList {
  id       Int     @id @default(autoincrement())
  name     String  @unique
  // Top-level category the list belongs to: Jobs | Forms | Finances | General
  category String  @default("General")
  order    Int     @default(0)
  isSystem Boolean @default(false)
  tasks    Task[]
}

model InspectionType {
  id          Int              @id @default(autoincrement())
  name        String           @unique
  order       Int              @default(0)
  inspections SiteInspection[]
}

// ---------- Clients ----------

model Client {
  id             Int              @id @default(autoincrement())
  name           String
  company        String           @default("")
  contactPerson  String           @default("")
  phone          String           @default("")
  mobile         String           @default("")
  email          String           @default("")
  billingAddress String           @default("")
  abn            String           @default("")
  notes          String           @default("")
  archived       Boolean          @default(false)
  createdAt      DateTime         @default(now())
  jobs           Job[]
  quotes         Quote[]
  invoices       Invoice[]
  tasks          Task[]
  activities     Activity[]
  calendarEvents CalendarEvent[]
}

// ---------- Quotes ----------

model Quote {
  id           Int         @id @default(autoincrement())
  quoteNumber  String      @unique
  date         DateTime    @default(now())
  clientId     Int
  client       Client      @relation(fields: [clientId], references: [id])
  contactName  String      @default("")
  siteAddress  String      @default("")
  // Structured site address; siteAddress stays as the formatted display string
  siteStreet   String      @default("")
  siteSuburb   String      @default("")
  project      String      @default("")
  projectType  String      @default("")
  scope        String      @default("")
  exclusions   String      @default("")
  subtotal     Float       @default(0)
  gst          Float       @default(0)
  total        Float       @default(0)
  validUntil   DateTime?
  notes        String      @default("")
  status       String      @default("Draft") // Draft | Sent | Accepted | Declined | Expired | Cancelled
  archived     Boolean     @default(false)
  createdAt    DateTime    @default(now())
  items        QuoteItem[]
  job          Job?
  activities   Activity[]
}

model QuoteItem {
  id          Int   @id @default(autoincrement())
  quoteId     Int
  quote       Quote @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  // Task heading, kept separate from the longer description
  name        String @default("")
  description String
  qty         Float @default(1)
  unitPrice   Float @default(0)
  amount      Float @default(0)
  gst         Boolean @default(true)
  order       Int   @default(0)
}

// ---------- Jobs ----------

model Job {
  id             Int              @id @default(autoincrement())
  jobNumber      String           @unique
  name           String
  clientId       Int
  client         Client           @relation(fields: [clientId], references: [id])
  clientContact  String           @default("")
  // Structured site address; siteAddress stays as the formatted display string
  siteAddress    String           @default("")
  siteStreet     String           @default("")
  siteSuburb     String           @default("")
  siteState      String           @default("")
  sitePostcode   String           @default("")
  siteCountry    String           @default("Australia")
  billingAddress String           @default("")
  description    String           @default("")
  scope          String           @default("")
  projectTypeId  Int?
  projectType    JobType?         @relation(fields: [projectTypeId], references: [id])
  statusId       Int
  status         JobStatus        @relation(fields: [statusId], references: [id])
  priority       String           @default("Normal") // Low | Normal | High | Urgent
  assignedEngineer String         @default("") // denormalised display name
  assignedEmployeeId Int?
  assignedEmployee   Employee?    @relation(fields: [assignedEmployeeId], references: [id])
  startDate      DateTime?
  dueDate        DateTime?
  completedAt    DateTime?
  quotedFee      Float            @default(0)
  variations     Float            @default(0)
  notes          String           @default("")
  quoteId        Int?             @unique
  quote          Quote?           @relation(fields: [quoteId], references: [id])
  // ----- Job Planner -----
  plannedStartDate  DateTime?
  plannedEndDate    DateTime?
  plannedDuration   Int?
  durationUnit      String   @default("working") // working | calendar
  plannerColor      String   @default("")
  plannerSortOrder  Int      @default(0) // manual vertical order on the planner
  unscheduledOrder  Int      @default(0) // manual order within Unscheduled Jobs
  archived       Boolean          @default(false)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  tasks          Task[]
  inspections    SiteInspection[]
  invoices       Invoice[]
  jobNotes       JobNote[]
  documents      Document[]
  forms          FormRecord[]
  activities     Activity[]
  calendarEvents CalendarEvent[]
}

// ---------- Tasks ----------

model Task {
  id          Int       @id @default(autoincrement())
  title       String
  description String    @default("")
  jobId       Int?
  job         Job?      @relation(fields: [jobId], references: [id])
  clientId    Int?
  client      Client?   @relation(fields: [clientId], references: [id])
  listId      Int
  list        TaskList  @relation(fields: [listId], references: [id])
  completed   Boolean   @default(false)
  priority    String    @default("Normal")
  important   Boolean   @default(false)
  inMyDay     Boolean   @default(false)
  myDayDate   DateTime?
  dueDate     DateTime?
  dueTime     String    @default("")
  reminder    DateTime?
  recurrence  String    @default("") // "", daily, weekly, monthly, yearly
  notes       String    @default("")
  sortOrder   Int       @default(0)
  parentId    Int?
  parent      Task?     @relation("Subtasks", fields: [parentId], references: [id])
  subtasks    Task[]    @relation("Subtasks")
  createdAt   DateTime  @default(now())
  completedAt DateTime?
  activities  Activity[]
}

// ---------- Site Inspections ----------

model SiteInspection {
  id            Int             @id @default(autoincrement())
  jobId         Int?
  job           Job?            @relation(fields: [jobId], references: [id])
  jobName       String          @default("")
  clientName    String          @default("")
  siteAddress   String          @default("")
  typeId        Int?
  type          InspectionType? @relation(fields: [typeId], references: [id])
  date          DateTime
  startTime     String          @default("09:00")
  endTime       String          @default("10:00")
  contactPerson String          @default("")
  contactPhone  String          @default("")
  contactEmail  String          @default("")
  notes         String          @default("")
  status        String          @default("Scheduled") // Scheduled | Confirmed | Completed | Cancelled | Rescheduled
  // Manual colour override; "" inherits the linked job's planner colour
  color         String          @default("")
  createdAt     DateTime        @default(now())
}

// ---------- General / personal calendar events (meetings, blocked time, ...) ----------

model CalendarEvent {
  id        Int      @id @default(autoincrement())
  title     String
  // Site Inspection | Meeting | Personal Appointment | Phone Call | Reminder | Blocked Time | Other
  type      String   @default("Other")
  date      DateTime
  startTime String   @default("09:00")
  endTime   String   @default("")
  allDay    Boolean  @default(false)
  location  String   @default("")
  notes     String   @default("")
  color     String   @default("#2563eb")
  jobId     Int?
  job       Job?     @relation(fields: [jobId], references: [id])
  clientId  Int?
  client    Client?  @relation(fields: [clientId], references: [id])
  createdAt DateTime @default(now())
}

// ---------- Invoices ----------

model Invoice {
  id              Int           @id @default(autoincrement())
  invoiceNumber   String        @unique
  date            DateTime      @default(now())
  dueDate         DateTime?
  clientId        Int
  client          Client        @relation(fields: [clientId], references: [id])
  billingAddress  String        @default("")
  jobId           Int?
  job             Job?          @relation(fields: [jobId], references: [id])
  siteAddress     String        @default("")
  // Structured site address; siteAddress stays as the formatted display string
  siteStreet      String        @default("")
  siteSuburb      String        @default("")
  description     String        @default("")
  subtotal        Float         @default(0)
  gst             Float         @default(0)
  total           Float         @default(0)
  amountPaid      Float         @default(0)
  notes           String        @default("")
  status          String        @default("Draft") // Draft | Sent | Part Paid | Paid | Overdue | Cancelled
  archived        Boolean       @default(false)
  createdAt       DateTime      @default(now())
  items           InvoiceItem[]
  payments        Payment[]
  activities      Activity[]
}

model InvoiceItem {
  id          Int     @id @default(autoincrement())
  invoiceId   Int
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  // Task heading, kept separate from the longer description
  name        String  @default("")
  description String
  qty         Float   @default(1)
  unitPrice   Float   @default(0)
  amount      Float   @default(0)
  gst         Boolean @default(true)
  order       Int     @default(0)
}

// Reusable line-item presets for quotes/invoices (site inspections, design, ...)
model InvoicePreset {
  id           Int     @id @default(autoincrement())
  name         String
  description  String  @default("")
  unitPrice    Float   @default(0)
  gstApplicable Boolean @default(true)
  defaultQty   Float   @default(1)
  active       Boolean @default(true)
  order        Int     @default(0)
}

model Payment {
  id        Int      @id @default(autoincrement())
  invoiceId Int
  invoice   Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  date      DateTime @default(now())
  amount    Float
  method    String   @default("")
  note      String   @default("")
}

// ---------- Job support ----------

model JobNote {
  id        Int      @id @default(autoincrement())
  jobId     Int
  job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  content   String
  pinned    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Document {
  id         Int      @id @default(autoincrement())
  jobId      Int
  job        Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  category   String   @default("Other")
  name       String
  revision   String   @default("A")
  filePath   String   @default("")
  uploadedAt DateTime @default(now())
}

model Activity {
  id        Int      @id      @default(autoincrement())
  message   String
  jobId     Int?
  job       Job?     @relation(fields: [jobId], references: [id])
  clientId  Int?
  client    Client?  @relation(fields: [clientId], references: [id])
  quoteId   Int?
  quote     Quote?   @relation(fields: [quoteId], references: [id])
  invoiceId Int?
  invoice   Invoice? @relation(fields: [invoiceId], references: [id])
  taskId    Int?
  task      Task?    @relation(fields: [taskId], references: [id])
  createdAt DateTime @default(now())
}

// ---------- Statutory forms (Form 15 / Form 12) ----------

model FormRecord {
  id           Int            @id @default(autoincrement())
  jobId        Int
  job          Job            @relation(fields: [jobId], references: [id], onDelete: Cascade)
  formType     String         // "form15" | "form12"
  status       String         @default("draft") // draft | ready | issued
  revision     Int            @default(0)
  inspectionId Int?
  data         String         @default("{}") // JSON of every form field value
  revisions    FormRevision[]
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@unique([jobId, formType])
}

model FormRevision {
  id        Int        @id @default(autoincrement())
  formId    Int
  form      FormRecord @relation(fields: [formId], references: [id], onDelete: Cascade)
  revision  Int
  fileName  String
  filePath  String
  createdAt DateTime   @default(now())
}

// ---------- Route planner: cached address → coordinates geocodes ----------

model GeocodeCache {
  id        Int      @id @default(autoincrement())
  address   String   @unique // normalised lowercase address string
  lat       Float
  lng       Float
  createdAt DateTime @default(now())
}
